# ============================================================================
# DIAMANTE AZUL — VARIABLES DE ENTORNO PARA SITEGROUND GOGEEK (NODE.JS + MYSQL)
# ============================================================================
# Configura estas variables en SiteGround -> Site Tools -> Devs -> Node.js
# (o en un archivo .env.local para pruebas locales con MySQL).
#
# El usuario y contraseña inicial del panel /admin (admin / diamanteazul26_$)
# se crean automáticamente en la tabla `admin_users` de MySQL al iniciar.
# ============================================================================

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=tu_usuario_mysql_siteground
MYSQL_PASSWORD=tu_password_mysql_siteground
MYSQL_DATABASE=tu_base_de_datos_siteground

# Clave secreta opcional para firmar la cookie de sesión del panel /admin
ADMIN_SESSION_SECRET=diamante_azul_session_secret_2026
